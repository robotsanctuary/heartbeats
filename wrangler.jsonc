// Cloudflare Worker that serves the public site: static files only, no script, no database.
// Build first (launch defaults: no dog, no Remembered), then deploy:
//   SITE_PREVIEW_DIR=/Volumes/Extreme/heartbeats-data/site-public ../heartbeats-venv/bin/python design/build_site.py
//   npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fadingheartbeats",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // Outside git (has scraped photos). Separate from the LAN preview, which may include dog test pages.
    "directory": "../../heartbeats-data/site-public",
    // Needed so / and /tx/dallas/ serve index.html ("none" 404s them). Side effect: /x.html redirects to /x.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
