// schema.prisma
// PostgreSQL schema for the At-Risk Animal Aggregator
//
// Run with:
//   npx prisma migrate dev --name init
//
// Core design:
//   - Pet is the anchor entity, keyed on the official shelter Pet ID.
//   - MediaSource is a 1-to-many child table so any number of social
//     media links (TikTok, Instagram, X, etc.) can point back to one Pet.
//   - PendingProfile holds animals discovered via social media that
//     don't yet have a matching official shelter Pet ID.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PetStatus {
  AT_RISK
  PENDING_VERIFICATION
  SAFE
  ADOPTED
  TRANSFERRED
  EUTHANIZED
  ARCHIVED
}

enum Species {
  DOG
  CAT
  OTHER
}

model Pet {
  // The official shelter Pet ID is the primary key / anchor for the
  // whole system. Every downstream script matches against this.
  petId             String        @id @map("pet_id")

  name              String?
  species           Species       @default(DOG)
  breed             String?
  age               String?       // shelters report this inconsistently, so free text
  sex               String?

  shelterName       String        @map("shelter_name")
  shelterLocation   String?       @map("shelter_location")
  intakeDate        DateTime?     @map("intake_date")
  intakeReason      String?       @map("intake_reason")

  deadlineTimestamp DateTime?     @map("deadline_timestamp")
  status            PetStatus     @default(AT_RISK)

  // Set only when status transitions to EUTHANIZED. Distinct from
  // deadlineTimestamp (the scheduled/threatened date) -- this is the
  // confirmed actual outcome date, once known, for the euthanized page.
  euthanizedAt      DateTime?     @map("euthanized_at")

  // Path to a LOCALLY downloaded copy of the shelter's photo, on the
  // external SSD. Downloaded as soon as the animal is first ingested
  // as AT_RISK -- not waited on -- because the shelter's own image URL
  // can vanish once the animal's record drops off their feed, and by
  // then it's too late to grab it. See image_archive.py.
  localImagePath    String?       @map("local_image_path")

  // True once the local copy has been promoted to a permanent memorial
  // (status became EUTHANIZED) rather than a temporary working copy
  // that gets deleted once the animal is resolved (SAFE/ADOPTED/
  // TRANSFERRED). Once true, image_archive.py's cleanup step will
  // never delete this file.
  imagePermanentlyArchived Boolean @default(false) @map("image_permanently_archived")

  // LOCAL-ONLY tracking of whether the permanent memorial photo has
  // already been uploaded to REMOTE Postgres (see publish.py). Prevents
  // re-uploading the same bytes on every incremental publish run just
  // because some other field on the pet changed.
  remoteImageUploadedAt DateTime? @map("remote_image_uploaded_at")

  // Free-text description, used as the fallback signal for fuzzy matching
  // when a social post doesn't carry an explicit pet ID.
  description       String?

  // The shelter's own live photo URL, for currently at-risk/adoptable
  // animals. Not guaranteed to stay valid once the animal's record
  // leaves the shelter's feed -- see localImagePath/euthanized_photo
  // for the durable copies.
  imageUrl          String?       @map("image_url")

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  lastSeenInScrapeAt DateTime?    @map("last_seen_in_scrape_at")

  mediaSources      MediaSource[]

  @@index([status])
  @@index([shelterName])
  @@index([deadlineTimestamp])
  @@map("pets")
}

model MediaSource {
  id          String   @id @default(uuid())
  petId       String   @map("pet_id")
  pet         Pet      @relation(fields: [petId], references: [petId], onDelete: Cascade)

  platform    String   // "tiktok" | "instagram" | "x" | "facebook"
  url         String
  postedBy    String?  @map("posted_by")   // the volunteer/coordinator handle
  postedAt    DateTime? @map("posted_at")
  rawText     String?  @map("raw_text")    // original caption, for audit/debug

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([petId, url])
  @@index([petId])
  @@map("media_sources")
}

// Holds animals seen only in social posts, with no shelter-confirmed
// Pet ID yet. Promoted to a full Pet row once Script A (shelter scraper)
// confirms a matching ID, or merged via fuzzy matching.
model PendingProfile {
  id              String   @id @default(uuid())
  extractedPetId  String?  @map("extracted_pet_id") // may be garbled/partial OCR text
  shelterNameGuess String? @map("shelter_name_guess")
  description     String?
  deadlineGuess   DateTime? @map("deadline_guess")

  platform        String
  url             String
  postedBy        String?  @map("posted_by")
  rawText         String?  @map("raw_text")

  // True when an AI decision landed in the "uncertain" band (see
  // audit_log) and needs a human to confirm/reject rather than being
  // auto-committed or auto-discarded.
  needsReview     Boolean  @default(false) @map("needs_review")
  reviewReason    String?  @map("review_reason")

  status          PetStatus @default(PENDING_VERIFICATION)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([needsReview])
  @@map("pending_profiles")
}

// LOCAL-ONLY. A single-row table tracking the last time publish.py
// successfully pushed to the remote database. Lets publish.py only
// select pets/media_sources changed since then, instead of re-pushing
// the entire table on every run. Not needed on the remote schema at all.
model PublishState {
  id              Int       @id @default(1)
  lastPublishedAt DateTime? @map("last_published_at")

  @@map("publish_state")
}
// One row per AI decision point (extraction or fuzzy match), regardless
// of outcome. This is the accuracy/drift-detection backbone: it lets you
// track confidence trends over time and spot-check what the model got
// wrong, instead of only noticing problems once bad data is user-facing.
model AuditLog {
  id              String    @id @default(uuid())

  // What kind of AI decision this record captures.
  stage           String    // "extraction" | "fuzzy_match"

  // The action matching_logic.py actually took as a result.
  action          String    // "APPENDED_TO_EXISTING_PET" | "CREATED_PENDING_PROFILE" | "FUZZY_MATCHED_AND_MERGED" | "FLAGGED_FOR_REVIEW"

  // Raw model input/output, kept verbatim for later spot-checking.
  inputText       String?   @map("input_text")
  modelOutput     String?   @map("model_output") // raw JSON string from the model

  confidence      Float?    // extraction confidence OR fuzzy-match probability
  relatedPetId    String?   @map("related_pet_id")

  platform        String?
  url             String?

  // Filled in later if/when a human reviews this decision. Lets you
  // measure real-world accuracy: correctCount / reviewedCount.
  humanVerdict    String?   @map("human_verdict") // "correct" | "incorrect" | null (unreviewed)
  reviewedAt      DateTime? @map("reviewed_at")

  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([stage])
  @@index([confidence])
  @@index([humanVerdict])
  @@map("audit_log")
}
