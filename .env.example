# Copy this file to .env and fill in real values.
# .env itself is gitignored -- never commit real credentials.

# --- Local database (the working/review DB) ---
# A single SQLite file -- nothing to install or run. All scraping, AI
# extraction, matching, and review happens here; it never leaves this
# machine. Relative paths are resolved against the repo folder. Put it
# on the external drive, e.g.:
#   LOCAL_DB_PATH="/Volumes/YourSSDName/heartbeats-data/heartbeats.db"
LOCAL_DB_PATH="./data/heartbeats.db"

# --- Remote database (what the live website reads from) ---
# NOT NEEDED YET -- hosting isn't chosen (may become Cloudflare D1
# instead of Postgres). Leave these as placeholders; publish.py
# --dry-run works without them.
# Only publish.py ever writes here, and only pets + media_sources rows
# that have already cleared review locally. Use a role scoped to
# INSERT/UPDATE on those two tables only -- not an admin/superuser
# connection string -- so a leaked value here can't touch anything
# beyond the public listing data, and can't be used to reach your
# local machine at all (this connection only ever goes outbound, from
# your machine to the host, never the reverse).
REMOTE_DATABASE_URL="postgresql://publisher:password@remote-host:5432/animals_public"

# The "moderator" role -- used only by moderate.py to review pending
# comments/social media submissions from the public website. Keep this
# local only; never give it to the website itself (the website uses
# its own "public_submitter" role, INSERT-only, configured separately
# on the website's own hosting platform, not in this .env).
MODERATOR_DATABASE_URL="postgresql://moderator:password@remote-host:5432/animals_public"

# --- LLM connection (used by ai_extractor.py and matching_logic.py's fuzzy match) ---
# Fully swappable -- OpenAI, LM Studio, Ollama, or whatever comes next
# all speak the same API shape, just at a different URL. Switching
# models later is just changing these three lines, no code changes.
#
# LM Studio (local, free) -- start LM Studio's local server, then:
#   LLM_BASE_URL=http://localhost:1234/v1
#   LLM_API_KEY=not-needed
#   LLM_MODEL=<the exact model name shown loaded in LM Studio>
#
# Ollama (local, free):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=not-needed
#   LLM_MODEL=gemma3:12b
#
# Real OpenAI API (costs money, leave LLM_BASE_URL blank to use it):
#   LLM_BASE_URL=
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
LLM_BASE_URL="http://localhost:1234/v1"
LLM_API_KEY="not-needed"
LLM_MODEL="gemma-3-12b"

# --- Local image archive ---
# Where downloaded shelter photos live on the external SSD, e.g.:
#   LOCAL_IMAGE_DIR="/Volumes/YourSSDName/animal-images"
# See image_archive.py for the retention rules (kept forever if
# EUTHANIZED, deleted once resolved safely).
LOCAL_IMAGE_DIR="./animal-images"

# --- Scheduled run log (one JSON line per run) ---
RUN_LOG_PATH="./data/runs.jsonl"
